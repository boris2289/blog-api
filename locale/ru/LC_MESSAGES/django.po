msgid "Email"
msgstr "Электронная почта"

msgid "First name"
msgstr "Имя"

msgid "Last name"
msgstr "Фамилия"

msgid "Password"
msgstr "Пароль"

msgid "Password confirmation"
msgstr "Подтверждение пароля"

msgid "Preferred language"
msgstr "Предпочитаемый язык"

msgid "Timezone"
msgstr "Часовой пояс"

msgid "Email is required"
msgstr "Электронная почта обязательна"

msgid "User with this email already exists."
msgstr "Пользователь с таким email уже существует."

msgid "Passwords do not match."
msgstr "Пароли не совпадают."

msgid "Invalid timezone. Use a valid IANA timezone name, for example: Asia/Almaty."
