msgid "Registration successful."
msgstr "Регистрация прошла успешно."

msgid "Preferred language updated successfully."
msgstr "Предпочитаемый язык успешно обновлен."

msgid "Timezone updated successfully."
msgstr "Часовой пояс успешно обновлен."

msgid "Too many requests. Try again later."
msgstr "Слишком много запросов. Попробуй позже."

msgid "Welcome to Blog API"
msgstr "Добро пожаловать в Blog API"

msgid "Hello %(first_name)s,"
msgstr "Здравствуйте, %(first_name)s,"

msgid "Thank you for registering in Blog API."
msgstr "Спасибо за регистрацию в Blog API."

msgid "We are glad to see you here."
msgstr "Мы рады видеть вас здесь."